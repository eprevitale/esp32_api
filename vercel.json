{
    "version":2,
    "builds":[
        {
            "src":"/src/app.js",
            "use":"@vercel/node"
        }
    ],
    "routes":[
        {
            "src":"/(.*)",
            "dest":"/src/app.js"
        }
    ],
    "build": {
        "env": {
        "NODE_VERSION": "20"
        }
    }
}